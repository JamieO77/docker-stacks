# ==========================================
# GLOBAL ENVIRONMENT VARIABLES
# ==========================================
TZ=Europe/Lisbon
DOCKER_HOST_IP=0.0.0.0

# ==========================================
# DEVELOPMENT STACK (devnet)
# ==========================================
DEV_MYSQL_ROOT_PASSWORD=insert_strong_password
DEV_MYSQL_USER_PASSWORD=insert_strong_password

# ==========================================
# N8N AUTOMATION STACK
# ==========================================
N8N_POSTGRES_USER=n8nuser_db
N8N_POSTGRES_PASSWORD=insert_strong_password
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=insert_strong_password
N8N_ENCRYPTION_KEY=insert_random_encryption_hash
N8N_RUNNERS_AUTH_TOKEN=insert_random_runner_hash
